{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER_NAME;Database=MeridianDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_YOUR_STRONG_SECRET_KEY_AT_LEAST_256_BITS",
    "Issuer": "MeridianCreditAPI",
    "Audience": "MeridianCreditApp",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "EnableDevAuthBypass": false,
  "IpWhitelist": [ "127.0.0.1", "::1" ],
  "UseInMemoryDatabaseIfSqlServerUnavailable": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
